# Databáze (PostgreSQL – Vercel Postgres / Neon / Supabase)
# DIRECT_URL = přímé spojení bez pooleru (pro migrace)
DATABASE_URL="postgresql://user:password@localhost:5432/monlii_eshop"
DIRECT_URL="postgresql://user:password@localhost:5432/monlii_eshop"

# Admin Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_secure_password_here
# Doporučeno místo ADMIN_PASSWORD: bcrypt hash hesla (má přednost)
# Vygenerování: node -e "console.log(require('bcryptjs').hashSync('tvoje-heslo', 12))"
# ADMIN_PASSWORD_HASH='$2b$12$...'

JWT_SECRET=your_jwt_secret_key_here_min_32_chars

# Email (Mailtrap – SMTP)
MAILTRAP_HOST=live.smtp.mailtrap.io
MAILTRAP_PORT=587
MAILTRAP_USER=api
MAILTRAP_PASS=your_mailtrap_password_here
EMAIL_FROM=noreply@monlii.cz
SELLER_EMAIL=your_seller_email@example.com

# Zásilkovna Z-BOX API (pouze serverová proměnná – NEPOUŽÍVAT prefix NEXT_PUBLIC_)
ZASILKOVNA_API_KEY=your_zasilkovna_api_key_here

# Vercel Blob Storage (for image uploads)
BLOB_READ_WRITE_TOKEN=your_vercel_blob_token_here

# App URLs
NEXT_PUBLIC_URL=https://monlii.cz

# Bank Account for QR Payments (Czech format)
BANK_ACCOUNT_NUMBER=7843801238
BANK_CODE=6363

# Vercel Cron Secret (povinné v produkci – bez něj cron endpoint odmítá požadavky)
CRON_SECRET=your_random_cron_secret_here
