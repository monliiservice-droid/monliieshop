# Database (Vercel Postgres / Neon / Supabase)
DATABASE_URL="postgresql://user:password@localhost:5432/monlii_eshop"
DIRECT_URL="postgresql://user:password@localhost:5432/monlii_eshop"

# Admin Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_secure_password_here
JWT_SECRET=your_jwt_secret_key_here_min_32_chars

# Email (Mailtrap Production)
MAILTRAP_HOST=live.smtp.mailtrap.io
MAILTRAP_PORT=587
MAILTRAP_USER=api
MAILTRAP_PASS=your_mailtrap_password_here
EMAIL_FROM=noreply@monlii.cz
SELLER_EMAIL=your_seller_email@example.com

# Zásilkovna Z-BOX API
NEXT_PUBLIC_ZASILKOVNA_API_KEY=your_zasilkovna_api_key_here

# Vercel Blob Storage (for image uploads)
BLOB_READ_WRITE_TOKEN=your_vercel_blob_token_here

# App URLs
NEXT_PUBLIC_URL=https://monlii.cz
NEXT_PUBLIC_ADMIN_URL=https://admin.monlii.cz

# Vercel Cron Secret (for protected cron jobs)
CRON_SECRET=your_random_cron_secret_here

# Instagram oEmbed API (optional)
INSTAGRAM_APP_ID=your_instagram_app_id
INSTAGRAM_APP_SECRET=your_instagram_app_secret
